<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_price_override_wizard" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.price.override.wizard</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_price_override_wizard"
                        type="object"
                        string="Price Override"
                        class="btn-primary"
                        invisible="state not in ('draft', 'sent')"/>
            </xpath>
        </field>
    </record>
</odoo>
