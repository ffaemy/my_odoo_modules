<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_sale_order_form_inherit_brand" model="ir.ui.view">
    <field name="name">sale.order.form.inherit.brand.odooistic</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//page[@name='other_information']//group[@name='sales_person']" position="inside">
        <field name="brand_id" options="{'no_create_edit': False}"/>
      </xpath>
    </field>
  </record>
</odoo>
