<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_price_override_wizard_form" model="ir.ui.view">
        <field name="name">price.override.wizard.form</field>
        <field name="model">price.override.wizard</field>
        <field name="arch" type="xml">
            <form string="Price Override" create="0" edit="1" delete="0">
                <group>
                    <field name="order_id" readonly="1"/>
                    <field name="discount_percent"/>
                </group>
                <group string="Live Preview">
                    <field name="amount_untaxed" readonly="1"/>
                    <field name="amount_tax" readonly="1"/>
                    <field name="amount_total" readonly="1"/>
                </group>
                <footer>
                    <button name="action_apply" string="Apply Discount" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
