<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_template_form_view_inherit_woocommerce_connector" model="ir.ui.view">
        <field name="name">product.template.form.inherit.woocommerce.connector</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="WooCommerce">
                    <group>
                        <field name="woo_id" readonly="1"/>
                        <field name="woo_sku" readonly="1"/>
                        <field name="woo_sync_date" readonly="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
